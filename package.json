{
  "name": "room-paint-studio",
  "private": true,
  "workspaces": ["apps/web", "apps/api"],
  "engines": {"node": ">=20.9"},
  "scripts": {
    "dev": "npm run dev -w apps/web",
    "dev:api": "npm run dev -w apps/api",
    "build": "npm run build -w apps/api && npm run build -w apps/web",
    "typecheck": "npm run typecheck --workspaces",
    "db:setup": "npm run db:setup -w apps/api",
    "migration:run": "npm run migration:run -w apps/api",
    "migration:revert": "npm run migration:revert -w apps/api"
  }
}
