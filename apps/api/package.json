{
  "name": "@room-paint/api",
  "private": true,
  "scripts": {
    "dev": "node --watch --watch-preserve-output -r ts-node/register src/main.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/apps/api/src/main.js",
    "typecheck": "tsc --noEmit",
    "migration:run": "npm run build && typeorm migration:run -d dist/apps/api/src/database/data-source.js",
    "migration:revert": "npm run build && typeorm migration:revert -d dist/apps/api/src/database/data-source.js"
  },
  "dependencies": {
    "@nestjs/common": "11.1.26",
    "@nestjs/core": "11.1.26",
    "@nestjs/platform-express": "11.1.26",
    "@nestjs/typeorm": "11.0.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.4",
    "dotenv": "17.4.2",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "0.3.29"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "typescript": "5.9.3",
    "ts-node": "10.9.2"
  }
}
